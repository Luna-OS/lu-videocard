{
  "name": "lu-videocard",
  "private": true,
  "version": "1.0.1",
  "description": "Lu Videocard – your HDMI capture card with clean sound and picture, under the night sky.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "productName": "Lu Videocard",
  "author": "Luna",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run && npm run test:main",
    "test:main": "node --test \"electron/**/*.test.cjs\"",
    "test:watch": "vitest",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "icons": "node scripts/make-icons.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "os.luna.lu-videocard",
    "productName": "Lu Videocard",
    "executableName": "Lu Videocard",
    "copyright": "Copyright © 2026 Luna",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "!electron/**/test/**",
      "!electron/**/*.test.cjs",
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Lu-Videocard-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lu Videocard",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Lu Videocard",
      "menuCategory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Lu-Videocard-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Luna-OS",
        "repo": "lu-videocard",
        "releaseType": "release"
      }
    ]
  }
}
